# Copy this file to .env and fill in real values. Never commit .env.

# From your Paystack dashboard: Settings -> API Keys & Webhooks
# Use the TEST keys while developing, LIVE keys only once you're ready to charge real cards.
PAYSTACK_SECRET_KEY=sk_test_72d966cb55e3aa9849da0b0611ec3140e7f4213c
PAYSTACK_PUBLIC_KEY=pk_test_577c71baadfd518c7075555164143fc1aa4c333d

# Currency Paystack should charge in. Paystack supports NGN, GHS, ZAR, KES (Kenya), USD (on some accounts).
# Check your dashboard to confirm which currencies are enabled for your account.
PAYSTACK_CURRENCY=KES

# Price of one note, in the currency's smallest unit (e.g. cents/kobo).
# Example: 200 KES => 20000. Adjust to whatever you're actually charging.
NOTE_PRICE_MINOR_UNITS=20000

# Where your frontend is hosted (GitHub Pages, Netlify, etc). Used for CORS and
# where the app redirects back to after payment (e.g. https://you.github.io/little-moments).
FRONTEND_URL=http://localhost:5500

# Where THIS backend itself is reachable (e.g. https://little-moments-backend.onrender.com).
# Paystack redirects the browser here first so payments are verified server-side
# before the frontend ever shows a "success" screen.
BACKEND_URL=http://localhost:3000

# Port the server listens on locally. Render/Railway/etc set this automatically in production.
PORT=3000
